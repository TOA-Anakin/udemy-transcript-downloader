UDEMY_EMAIL=your-email@example.com

# Optional: path to a specific browser binary for Puppeteer to launch.
# Leave unset to use Puppeteer's bundled Chromium. Set this if the bundled
# browser fails to start (for example, Apple Silicon Macs where the bundled
# "Chrome for Testing" ships unsigned and is killed by the OS on launch).
# Point it at a locally installed, properly signed Chromium-based browser:
#   macOS:   PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Linux:   PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
#   Windows: PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PUPPETEER_EXECUTABLE_PATH=
